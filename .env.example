# Copy this file to .env and fill in the values.
#   cp .env.example .env
# .env is in .gitignore, so it never reaches GitHub.

# Claude API (LLMClient's default, used when the model is claude-...) https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Vercel AI Gateway (https://vercel.com/ai-gateway). One key reaches Claude, other providers' models and Jev.
# Only models whose own provider key is missing go through it automatically (for Claude: when ANTHROPIC_API_KEY is empty).
# To send Claude through the gateway even with an Anthropic key present, set ANTHROPIC_BASE_URL.
# A credit card must be registered on Vercel first (free credits included); without one every call fails with 403.
# AI_GATEWAY_API_KEY=
# ANTHROPIC_BASE_URL=https://ai-gateway.vercel.sh

# Models other than Claude (e.g. LLMClient(model="openai/gpt-5")).
# They are called through LiteLLM, so `pip install "mekiki[litellm]"` is needed.
# Only the keys of the providers you use are needed. The variable names follow LiteLLM's
# conventions (https://docs.litellm.ai/docs/providers). When one is missing,
# LLMClient.why_unavailable() tells you which names it looked for.
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Jev (System One) from TypeSafe AI: the middle tier between the statistical models and the LLM.
# A TypeSafe key is used if present; otherwise AI_GATEWAY_API_KEY above reaches Jev
# through the Vercel AI Gateway (model name typesafe-ai/jev).
# With neither set, the Jev tier is skipped and everything runs in two tiers (statistical model, then LLM).
TYPESAFE_API_KEY=

# Kaggle (not needed if you use `kaggle auth login`)
KAGGLE_API_TOKEN=
