# macOS
.DS_Store

# --- データ ---
# raw/       : 外部から再取得できる巨大な生データ。scripts/download_data.py で取得する
# processed/ : 分析途中の中間データ。コードから再生成できる
# どちらも中身は git 管理しないが、ディレクトリ自体は残したいので .gitkeep だけ通す
sampledata/raw/*
!sampledata/raw/.gitkeep
sampledata/processed/*
!sampledata/processed/.gitkeep

# sampledata/scraped/ と sampledata/sample/ は git 管理する（再取得できない / 小さい）

# APIキー。絶対にコミットしないこと（.env.example が雛形）
.env

# Python
.venv/
# 埋め込み計算専用の隔離環境（torch 2.2.2 + numpy 1.x）。
# 主環境の numpy 2.x と非互換なので分けてある。scripts/setup_embed_env.sh で作れる
.venv-embed/
__pycache__/
*.pyc
venv/
.ipynb_checkpoints/

# 個人メモ（共有しない）
CLAUDE.local.md

# Excel の一時ロックファイル
~$*

# インストーラの一時ファイル（AWS CLI など）。誤って 2075c3b でコミットしたことがある
awscliv2.zip
AWSCLIV2.pkg
sessionmanager-bundle*
